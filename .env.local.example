# Copy this file to .env.local and fill in your own values.
# (On Vercel, add the same four variables under Project -> Settings -> Environment Variables.)

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase "service_role" / "secret" key. SERVER-ONLY: never prefix with NEXT_PUBLIC_.
# It lets the admin panel write to the database and create upload URLs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The password you type at /admin/login. SERVER-ONLY. Make it long.
ADMIN_PASSWORD=choose-a-long-strong-password

# Without the two NEXT_PUBLIC_SUPABASE_ variables the site shows built-in
# sample projects, so it always runs before the database is connected.
